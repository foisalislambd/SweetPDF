# Keeps whitespace consistent regardless of which editor a contributor uses.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,h,hpp}]
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{desktop,xml,metainfo.xml}]
indent_size = 2

[Makefile]
indent_style = tab
